# Database Configuration
DB_DRIVER=sqlite
SQLITE_PATH=./data/voidlark.db
# Optional kalau ingin tetap pakai PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:password@localhost:5432/voidlark

# Automated database backup (local; copy this directory off-host separately)
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=./backups/database
DB_BACKUP_RETENTION=14
DB_BACKUP_INTERVAL_MINUTES=1440
DB_BACKUP_RUN_ON_START=false

# AI Configuration (OpenAI-compatible endpoint)
AI_API_BASE_URL=http://localhost:20128/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini/gemini-2.5-flash
# Legacy fallback only:
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# App Configuration
PRODUCT_TYPE=non-digital
HOST=127.0.0.1
PORT=3000
# Required in production. Use at least 16 characters and do not use a documented/default value.
ADMIN_PASSWORD=
# JSON array, e.g. [{"name":"backup_fresh","metric":"backup_age_seconds","threshold":172800}]
SLO_RULES_JSON=[]
# Optional local JSONL alert sink (no cloud credentials required)
ALERT_LOG_HOOK_FILE=
LOG_LEVEL=info
INBOUND_CONCURRENCY=3
INBOUND_MEDIA_ROOT=./data/inbound-media
INBOUND_MEDIA_MAX_BYTES=10485760

# Optional payment webhook: POST /webhooks/payment
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-payment-signature

# RajaOngkir / Komerce Shipping Cost
RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here,your_backup_rajaongkir_api_key_here
STORE_DESTINATION_ID=
STORE_CITY_NAME=Bantul
SHIPPING_COURIERS=jne,sicepat,ide,sap,ninja,jnt,tiki,wahana,pos,sentral,lion,rex
# Fallback kalau ukuran pesanan belum terbaca. Jika terbaca: 30ml=110g, 50ml=275g, 100ml=440g per botol.
SHIPPING_WEIGHT_GRAMS=500

# Human Handoff — JID admin WhatsApp (format: 628xxxxxxxxxx@s.whatsapp.net)
ADMIN_WA_JID=

# Business hours, timezone, holidays, SLA, and consent keywords are configured in business.config.json or Admin > Profil & Alur.

# External product lookup (optional). Tavily punya free tier; Brave opsional.
# Pisahkan beberapa key dengan koma. Key dirotasi otomatis saat limit/invalid.
# Enable also in business.config.json: enableExternalProductLookup=true
# BRAVE_SEARCH_API_KEY=your_brave_key,your_backup_brave_key
# TAVILY_API_KEY=your_tavily_key,your_backup_tavily_key
